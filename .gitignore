# Dependencies and build output
node_modules/
dist/
dist-ssr/
*.local

# Secrets: never commit keys, tokens or credentials
.env
.env.*
!.env.example
*.pem
*.key
secrets/
credentials*.json

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# Large temporary downloads and raw (uncompressed) art
tmp/
.tmp/
downloads/
assets/**/raw/
*.zip
*.tar.gz

# Tooling caches
.eslintcache
coverage/
.vite/
